APP_NAME=CoinoskobiDEX
CHAIN=bsc

# Quota-aware provider broker.
# Configure only the providers you actually own/use.
RPC_URL=https://bsc-dataseed.binance.org/
RPC_URL_SECONDARY=
RPC_URL_TERTIARY=
RPC_URL_QUATERNARY=
RPC_PROVIDER_COOLDOWN_SECONDS=300

WSS_URL=
WSS_URL_SECONDARY=
WSS_URL_TERTIARY=
WSS_URL_QUATERNARY=

WSS_PAIR=
WSS_TOKEN=

# Phase 14 read-only Vezir semantic routing.
# Leave GROQ_API_KEY empty to use deterministic-only fallback.
GROQ_API_KEY=
VEZIR_GROQ_MODEL=openai/gpt-oss-120b

PRIVATE_KEY=
WALLET_ADDRESS=
LOG_LEVEL=INFO
